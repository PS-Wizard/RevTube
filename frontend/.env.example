# YouTube Data API Configuration
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# Firebase Authentication Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: Firestore — Firefox uses forced long-polling in code (fixes NS_BINDING on Listen).
# Force long polling on all browsers (strict proxy): VITE_FIRESTORE_FORCE_LONG_POLLING=1
# Opt out on Firefox and use WebChannel + auto-detect (debug only): VITE_FIRESTORE_PREFER_WEB_CHANNEL=1

# Google OAuth Client ID for YouTube API access
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Optional: Hardcode redirect URI to prevent "redirect_uri_mismatch"
# This MUST EXACTLY MATCH one of the authorized redirect URIs in Google Cloud Console
# VITE_OAUTH_REDIRECT_URI=https://revtube.revketer.ai/oauth-callback.html

# Allowed Email Domains (comma-separated, without @)
# Example: test.ai,example.com,company.org
VITE_ALLOWED_EMAIL_DOMAINS=revketer.ai

# Backend API (path on same origin, or full URL). Default `/api` uses Vite dev proxy -> VITE_DEV_API_PROXY_TARGET
# VITE_BACKEND_URL=/api
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3000
# Production / direct backend: VITE_BACKEND_URL=https://api.example.com/api

# Instructions:
# 1. Copy this file to .env
# 2. Replace 'your_youtube_api_key_here' with your actual YouTube Data API v3 key
# 3. Get your API key from: https://console.cloud.google.com/
# 4. Set up Firebase Authentication:
#    - Go to https://console.firebase.google.com/
#    - Create a new project or select existing one
#    - Enable Google Sign-In in Authentication > Sign-in method
#    - Add your domain to authorized domains
#    - Copy your Firebase config values to the variables above
