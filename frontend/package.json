    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.14",
    "rollup-plugin-visualizer": "^5.14.0",
    "stylelint": "^17.14.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
