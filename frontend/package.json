{
  "name": "youtube-metadata-fetcher",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "description": "Professional web app to fetch and export YouTube playlist video metadata",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:docker": "vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "lint": "eslint .",
    "test": "vitest run",
    "design:lint": "stylelint \"src/**/*.css\"",
    "design:lint:strict": "stylelint \"src/**/*.css\" --max-warnings=0",
    "ui:boundary": "node scripts/check-ui-boundary.mjs",
    "perf:budget": "pnpm run build && node scripts/check-budgets.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
