

NODE_ENV=development
REQUEST_LOG=true
# YouTube API Configuration
YOUTUBE_API_KEY=APi Key
VITE_GOOGLE_CLIENT_ID=Client ID
YOUTUBE_CLIENT_ID=Client ID
YOUTUBE_CLIENT_SECRET=Secret Key
# Comma-separated redirect URIs allowed for the OAuth token exchange
# (defaults to $VITE_FRONTEND_URL + /oauth-callback.html; loopback always allowed)
# The backend keeps NO hardcoded hosts — every production domain must be
# declared here (or in the deployment's env) and registered in the Google
# Cloud OAuth client's Authorized redirect URIs.
# YOUTUBE_OAUTH_REDIRECT_URIS=https://your-domain.com/oauth-callback.html

# Firebase Configuration (Frontend)
VITE_FIREBASE_API_KEY=API_KEY
VITE_FIREBASE_AUTH_DOMAIN=Auth Domain
VITE_FIREBASE_PROJECT_ID=Project ID
VITE_FIREBASE_STORAGE_BUCKET=Storage Bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=Messaging Sender ID
VITE_FIREBASE_APP_ID=Application ID
VITE_FIREBASE_MEASUREMENT_ID= Mesurement ID


# Backend URL (used by frontend to call backend API)
# In production behind a reverse proxy (Coolify/nginx): leave as /api
# In local development without a proxy: set to http://localhost:3000/api
VITE_BACKEND_URL=/api

# Port Configuration
BACKEND_PORT=3000
FRONTEND_PORT=8081
REDIS_PORT=6379
POSTGRES_PORT=5432


# Firebase Admin SDK (required for backend to access Firestore/Auth with admin privileges)
# Generate from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Paste the entire JSON content as a single-line string (or use a secrets manager)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key":"<YOUR_PRIVATE_KEY>","client_email":"<YOUR_CLIENT_EMAIL>"}
# Frontend URL (used by backend to generate invite/transfer links in emails)
# Set this to the public URL of your frontend (no trailing slash).
# On Coolify this can be left unset — the compose stack falls back to
# $SERVICE_URL_FRONTEND (magic variable on the `frontend` service).
VITE_FRONTEND_URL=http://localhost:8081

# Also used by the backend to build the OAuth redirect URI allowlist and the
# CORS origin allowlist, so the production domain is configured here rather
# than baked into the source. No production host is hardcoded in the backend.

# Additional CORS origins, comma-separated, if the frontend is served from
# more than one host (e.g. a preview deployment). FRONTEND_URL and
# SERVICE_URL_FRONTEND are also honoured.
# CORS_ORIGINS=https://your-domain.com

# Email / SMTP Configuration (required for sending invitation and ownership transfer emails)
# Works with any SMTP provider: Gmail, Resend, SendGrid, Mailgun, Zoho, etc.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-account@gmail.com
#   SMTP_PASS=your-16-char-app-password   (use an App Password, not your account password)
#
# Resend example (recommended):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=re_your_api_key
#
# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=SG.your_api_key
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email@example.com
SMTP_PASSWORD=password
SMTP_FROM=noreply@test.com
SMTP_FROM_NAME=TubeKeter AI by RevKeter

# Redis Cache Configuration (Optional - for production)
# Leave empty to use in-memory cache (default)
# Set to enable persistent, distributed caching across server restarts
# Examples:
#   Local: redis://localhost:6379
#   With password: redis://:password@localhost:6379
#   Remote: redis://username:password@redis-host:6379
# Note: When using Docker Compose, the host should be 'redis' (service name)
# REDIS_URL=redis://localhost:6379

# PostgreSQL Analytics Store
# Required for postgres-first ingestion pipeline.
POSTGRES_HOST=localhost
POSTGRES_DB=revtube
POSTGRES_USER=revtube
POSTGRES_PASSWORD=change_me_secure_password

# Backend analytics read mode
# postgres-first: Redis -> Postgres -> YouTube fallback
# youtube-only: existing request-time YouTube fetch flow
ANALYTICS_SOURCE=postgres-first



# Usage counter dedup window for parallel cache misses (seconds)
# Prevents multiple simultaneous requests from each independently incrementing the monthly counter.
# Default is 5. Set to 0 to disable. Only effective when Redis is available.
USAGE_DEDUP_WINDOW_SEC=5

# Compression of the Cache Control 
DISABLE_COMPRESSION=1

# Performance Logging
PERF_LOG=1

# AI Chat Agent Configuration
# DeepSeek API key for the AI chat assistant
DEEPSEEK_API_KEY=key-goes-here

DEEPSEEK_MODEL=deepseek-v4-flash
CHAT_MAX_TOKENS=4096
CHAT_MAX_ITERATIONS=10
CHAT_CONV_TTL_MINUTES=30
# Per-mode output budgets (user key above is the user-level budget)
CHAT_USER_MAX_TOKENS=4096
# Admin output ceiling -- the model API caps output (deepseek-chat: 8192)
CHAT_ADMIN_MAX_TOKENS=8192
# Conversation history window (messages) per mode
CHAT_MAX_HISTORY=20
CHAT_ADMIN_MAX_HISTORY=60
# Identical consecutive tool calls before the infinite-loop breaker trips
CHAT_MAX_TOOL_REPEATS=3

# Google Gemini API Key (for Thumbnail Optimizer)
GEMINI_API_KEY=key-goes-here








# Server-side cache tuning
# CACHE_MAX_ENTRIES: in-process LRU size used when Redis is unavailable.
CACHE_MAX_ENTRIES=1000
# CACHE_FALLBACK_TTL_HOURS: how long an entry may live in the in-process
# fallback cache. Deliberately conservative so a Redis outage cannot serve
# stale data for a full day.
CACHE_FALLBACK_TTL_HOURS=12

# Scheduled ingestion caps (cron: 0 3,9,15,21 * * *)
# Channels are ordered most-recently-active first, so raising a cap is all
# that is needed to give a growing channel base full coverage. Set a cap to 0
# for "no cap". Only raise CRON_STAGGER_MS if the enqueue burst starves workers.
CRON_WARM_MAX_CHANNELS=50
CRON_INGEST_MAX_CHANNELS=100
CRON_INGEST_DAYS=730
CRON_STAGGER_MS=500

# Playlist read-model freshness window (hours).
# Playlists are ingested into Postgres by the 6-hour cron (0 3,9,15,21 * * *).
# Reads (chat playlist tools) serve from Postgres while it is within this window
# and only fall back to the live YouTube API when it is older. Set 0 to always
# refresh from YouTube.
PLAYLISTS_READ_MODEL_MAX_AGE_HOURS=6

# Playlist ingestion caps (YouTube quota guard-rails, per channel per run).
# /playlists returns 50 rows per unit, so PLAYLIST_SYNC_LIMIT=50 costs 1-2 units.
PLAYLIST_SYNC_LIMIT=50
# Membership rows fetched per playlist (50 = 1 unit each). Set 0 to sync the
# catalog only and let playlist video lists fall back to the live API.
PLAYLIST_ITEMS_SYNC_LIMIT=500